{
  "name": "riposte",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace @riposte/admin run dev",
    "build": "npm --workspace @riposte/admin run build",
    "preview": "npm --workspace @riposte/admin run preview",
    "typecheck:core": "npm --workspace @riposte/core run typecheck"
  }
}
